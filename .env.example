# Supabase — Project Settings > API (proyecto real, se completa cuando exista)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Prisma — Project Settings > Database, connection strings de Supabase
# DATABASE_URL: pooled (pgbouncer, puerto 6543) — la usa la app en runtime
DATABASE_URL=
# DIRECT_URL: conexión directa (puerto 5432) — la usa `prisma migrate` para DDL
DIRECT_URL=
