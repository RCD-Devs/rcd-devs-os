// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Driver adapters (@prisma/adapter-pg): la conexion a Postgres la maneja el
// driver "pg" en JS, no el motor nativo de Prisma (Rust/.so.node). Se cambio
// a esto despues de 3 intentos fallidos de empaquetar el binario nativo
// correctamente en Vercel (outputFileTracingIncludes, binaryTargets, glob
// recursivo — el error PrismaClientInitializationError persistia en
// produccion pese a verificarse localmente). Sin motor nativo que
// desplegar, esta clase de problema desaparece por completo.
generator client {
  provider   = "prisma-client"
  output     = "../app/generated/prisma"
  // Sin esto, el generador sigue emitiendo el motor binario nativo aunque
  // se use un driver adapter en runtime. "client" cambia al compilador de
  // queries en JS/WASM, sin binario especifico por plataforma/OS.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Espejo de auth.users, sincronizado por trigger (ver migration.sql de trigger_usuario_sync).
/// El id es el mismo UUID que Supabase Auth asigna al usuario.
model Usuario {
  id     String  @id @db.Uuid
  nombre String?
  email  String  @unique
  rolId  String? @map("rol_id") @db.Uuid
  rol    Rol?    @relation("UsuarioRol", fields: [rolId], references: [id])

  rolesComoTitular   Rol[]             @relation("RolTitular")
  rolesComoReemplazo Rol[]             @relation("RolReemplazo")
  pasosResponsable   EjecucionPaso[]
  solicitudesCreadas Solicitud[]       @relation("SolicitudSolicitante")
  eventosAuditoria   EventoAuditoria[]
  comentarios        Comentario[]

  @@map("Usuario")
}

/// Catalogo fijo de roles del roadmap (roadmap.md #2). Se siembra por nombre; titular/reemplazo
/// se asignan a mano despues (no hay UI de administracion en el spec de Auth).
model Rol {
  id          String  @id @default(uuid()) @db.Uuid
  nombre      String  @unique
  titularId   String? @map("titular_id") @db.Uuid
  reemplazoId String? @map("reemplazo_id") @db.Uuid
  /// Control total: Roles/permisos + cualquier CRUD del resto de la app.
  /// Fijo a Lider tecnico y Director/a por decision del equipo, editable
  /// despues desde /roles por cualquier admin existente.
  esAdmin     Boolean @default(false) @map("es_admin")

  titular            Usuario?     @relation("RolTitular", fields: [titularId], references: [id])
  reemplazo          Usuario?     @relation("RolReemplazo", fields: [reemplazoId], references: [id])
  usuarios           Usuario[]    @relation("UsuarioRol")
  solicitudes        Solicitud[]
  permisosBloqueados RolPermiso[]

  @@map("Rol")
}

/// Matriz de permisos por rol, como lista de EXCEPCIONES (no de permisos):
/// una fila presente significa "este rol NO puede hacer esta accion sobre
/// este recurso". Sin fila = permitido. Los roles admin (Rol.esAdmin) nunca
/// se filtran contra esta tabla, siempre tienen control total. Elegido asi
/// (deny-list) en vez de una lista de permisos otorgados porque el pedido
/// real fue "todos pueden X excepto el rol Y" — una sola fila por excepcion,
/// en vez de tener que otorgar el permiso a cada rol existente uno por uno.
model RolPermiso {
  id      String @id @default(uuid()) @db.Uuid
  rolId   String @map("rol_id") @db.Uuid
  recurso String // "protocolos" | "proyectos" | "clientes" | "solicitudes"
  accion  String // "crear" (accion "eliminar" no vive aca: eliminar es siempre admin-only)

  rol Rol @relation(fields: [rolId], references: [id])

  @@unique([rolId, recurso, accion])
  @@map("RolPermiso")
}

model Cliente {
  id               String  @id @default(uuid()) @db.Uuid
  nombre           String  @unique
  contactoNombre   String? @map("contacto_nombre")
  contactoEmail    String? @map("contacto_email")
  contactoTelefono String? @map("contacto_telefono")
  rubro            String?
  sitioWeb         String? @map("sitio_web")
  notas            String?

  proyectos Proyecto[]

  @@map("Cliente")
}

/// Catalogo fijo de las 8 etapas oficiales del ciclo de vida (roadmap #1). Se siembra
/// una sola vez; no hay UI para agregar/editar etapas en este spec.
model Etapa {
  id              String @id @default(uuid()) @db.Uuid
  nombre          String @unique
  orden           Int    @unique
  gateDescripcion String @map("gate_descripcion")

  proyectos Proyecto[]

  @@map("Etapa")
}

/// Sin integracion JIRA en este spec: el proyecto se gestiona 100% dentro de RCD OS.
model Proyecto {
  id              String    @id @default(uuid()) @db.Uuid
  clienteId       String    @map("cliente_id") @db.Uuid
  nombre          String
  etapaActualId   String    @map("etapa_actual_id") @db.Uuid
  fechaInicio     DateTime? @map("fecha_inicio") @db.Date
  fechaCompromiso DateTime? @map("fecha_compromiso") @db.Date

  cliente     Cliente @relation(fields: [clienteId], references: [id])
  etapaActual Etapa   @relation(fields: [etapaActualId], references: [id])

  ejecucionesProtocolo EjecucionProtocolo[]
  solicitudes          Solicitud[]

  @@map("Proyecto")
}

model Protocolo {
  id       String @id @default(uuid()) @db.Uuid
  nombre   String @unique
  objetivo String
  alcance  String

  versiones VersionProtocolo[]

  @@map("Protocolo")
}

/// Plantilla congelada: pasosJson/estadosJson son la fuente desde la que se generan
/// las filas EjecucionPaso cuando se inicia una ejecucion. Versionar aca es lo que
/// permite publicar una v2 sin romper ejecuciones ya iniciadas con la v1.
model VersionProtocolo {
  id               String   @id @default(uuid()) @db.Uuid
  protocoloId      String   @map("protocolo_id") @db.Uuid
  numeroVersion    Int      @map("numero_version")
  fechaPublicacion DateTime @default(now()) @map("fecha_publicacion")
  /// Lista ordenada de pasos: [{ nombre: string, ... }]
  pasosJson        Json     @map("pasos_json")
  /// Lista ordenada de estados validos para esta version, ej. ["Pendiente","En curso","Completo","No aplica"]
  estadosJson      Json     @map("estados_json")

  protocolo   Protocolo            @relation(fields: [protocoloId], references: [id])
  ejecuciones EjecucionProtocolo[]

  @@unique([protocoloId, numeroVersion])
  @@map("VersionProtocolo")
}

model EjecucionProtocolo {
  id                 String    @id @default(uuid()) @db.Uuid
  proyectoId         String    @map("proyecto_id") @db.Uuid
  versionProtocoloId String    @map("version_protocolo_id") @db.Uuid
  estado             String    @default("En curso")
  fechaLimite        DateTime? @map("fecha_limite") @db.Date

  proyecto         Proyecto         @relation(fields: [proyectoId], references: [id])
  versionProtocolo VersionProtocolo @relation(fields: [versionProtocoloId], references: [id])
  pasos            EjecucionPaso[]

  @@map("EjecucionProtocolo")
}

model EjecucionPaso {
  id             String    @id @default(uuid()) @db.Uuid
  ejecucionId    String    @map("ejecucion_id") @db.Uuid
  pasoNombre     String    @map("paso_nombre")
  estado         String
  responsableId  String?   @map("responsable_id") @db.Uuid
  evidenciaUrl   String?   @map("evidencia_url")
  fechaEjecucion DateTime? @map("fecha_ejecucion")
  notas          String?

  ejecucion   EjecucionProtocolo @relation(fields: [ejecucionId], references: [id])
  responsable Usuario?           @relation(fields: [responsableId], references: [id])
  comentarios Comentario[]

  @@map("EjecucionPaso")
}

/// Flujo de solicitud interno (roadmap #5), sin integracion JIRA: formulario
/// -> se asigna a un rol (no a una persona) -> se resuelve. `tipo` es texto
/// libre a proposito (constructor simple, mismo criterio que Protocolo/Paso)
/// en vez de un catalogo fijo que el roadmap no llego a definir.
model Solicitud {
  id               String    @id @default(uuid()) @db.Uuid
  proyectoId       String    @map("proyecto_id") @db.Uuid
  tipo             String
  descripcion      String?
  estado           String    @default("Pendiente")
  solicitanteId    String    @map("solicitante_id") @db.Uuid
  responsableRolId String    @map("responsable_rol_id") @db.Uuid
  slaFechaLimite   DateTime? @map("sla_fecha_limite") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")

  proyecto       Proyecto @relation(fields: [proyectoId], references: [id])
  solicitante    Usuario  @relation("SolicitudSolicitante", fields: [solicitanteId], references: [id])
  responsableRol Rol      @relation(fields: [responsableRolId], references: [id])

  @@map("Solicitud")
}

/// Append-only (roadmap #6): nunca se borra ni edita una fila desde la app.
/// `entidad`/`entidadId` apuntan a la fila afectada (ej. "Proyecto", uuid) sin
/// FK real, porque puede referenciar cualquier tabla.
model EventoAuditoria {
  id        String   @id @default(uuid()) @db.Uuid
  entidad   String
  entidadId String   @map("entidad_id") @db.Uuid
  usuarioId String?  @map("usuario_id") @db.Uuid
  accion    String
  detalle   Json?
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([entidad, entidadId])
  @@map("EventoAuditoria")
}

/// Historial de comentarios por paso de checklist (no estaba en el roadmap
/// original): el campo "notas" de EjecucionPaso es unico y se sobreescribe,
/// esto permite que varias personas dejen contexto sin pisarse.
model Comentario {
  id              String   @id @default(uuid()) @db.Uuid
  ejecucionPasoId String   @map("ejecucion_paso_id") @db.Uuid
  autorId         String   @map("autor_id") @db.Uuid
  texto           String
  createdAt       DateTime @default(now()) @map("created_at")

  ejecucionPaso EjecucionPaso @relation(fields: [ejecucionPasoId], references: [id])
  autor         Usuario       @relation(fields: [autorId], references: [id])

  @@map("Comentario")
}
