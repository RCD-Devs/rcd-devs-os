# Supabase — Project Settings > API (proyecto real, se completa cuando exista)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional: solo necesaria para crear/editar/eliminar usuarios desde /usuarios
# (Project Settings > API > service_role key). Es la clave mas sensible del
# proyecto: bypassa RLS por completo y tiene acceso total a Supabase Auth y a
# la base. NUNCA exponer con prefijo NEXT_PUBLIC_, solo se usa server-side
# (ver lib/supabase/admin.ts). Si se filtra (log, commit, captura de pantalla),
# rotarla de inmediato desde Supabase (Project Settings > API > service_role >
# Roll) y actualizar la variable en Vercel (Production) y en el .env local de
# cada dev que la tenga.
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — Project Settings > Database, connection strings de Supabase
# DATABASE_URL: pooled (pgbouncer, puerto 6543) — la usa la app en runtime
DATABASE_URL=
# DIRECT_URL: conexión directa (puerto 5432) — la usa `prisma migrate` para DDL
DIRECT_URL=
